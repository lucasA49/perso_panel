# Copie ce fichier en ".env.local" (en local) et remplis les valeurs.
# Sur Hostinger : saisis ces mêmes variables dans le panneau de l'application Node.js.

# --- Base de données PostgreSQL ---
# Neon / Supabase : colle l'URL de connexion fournie
# VPS : l'URL du Postgres installé sur le serveur
DATABASE_URL=postgresql://user:password@host:5432/perso_panel

# "true" si la base demande le SSL (Neon / Supabase). "false" pour un Postgres local.
DATABASE_SSL=true

# --- Notifications Web Push (VAPID) ---
# Génère ces clés une seule fois avec : npm run gen-vapid
# NE PAS les régénérer ensuite (sinon les abonnements push existants cassent).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@example.com

# --- Rappels (optionnel) ---
# Secret pour déclencher la vérification des rappels depuis une tâche cron externe :
#   GET /api/cron/reminders?secret=<CRON_SECRET>
# Utile si l'hébergeur met l'application en veille quand personne ne la visite.
CRON_SECRET=
