# Copie ce fichier en ".env" et remplis les valeurs

# --- Base de données PostgreSQL ---
# En local/dev avec Neon : colle l'URL de connexion fournie par Neon
# Sur le VPS Hostinger : l'URL de ton Postgres installé sur le serveur
DATABASE_URL=postgresql://user:password@host:5432/perso_panel

# Mets "true" si ta base demande le SSL (cas de Neon / Supabase). "false" sur un Postgres local du VPS.
DATABASE_SSL=true

# --- Serveur ---
PORT=4000

# Origine autorisée (l'URL de ton site). En dev : http://localhost:5173
# En prod : https://ton-domaine.fr
CLIENT_ORIGIN=http://localhost:5173

# --- Notifications Web Push (VAPID) ---
# Génère ces clés une seule fois avec : npm run gen-vapid
# puis colle-les ici. NE PAS les régénérer ensuite (sinon tes abonnements push cassent).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@example.com
